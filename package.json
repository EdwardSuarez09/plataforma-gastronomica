{
  "name": "plataforma-gastronomica",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=22.13" },
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "lint": "eslint .",
    "test": "npm test -w server && npm test -w web",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^16.0.0"
  }
}
